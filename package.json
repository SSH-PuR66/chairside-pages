{
    "name": "chairside-pages",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run build && serve dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{html,css,js}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
        "format:check": "prettier --check \"src/**/*.{html,css,js}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
        "build": "node scripts/build.mjs",
        "build:check": "node scripts/check-build.mjs"
    },
    "devDependencies": {
        "prettier": "^3.3.0",
        "serve": "^14.2.0",
        "vitest": "^5.0.3"
    }
}
